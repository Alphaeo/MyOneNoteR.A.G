# Copie ce fichier en `.env` et remplis les valeurs. Ne commit jamais `.env`.

# --- Azure App Registration (Graph API) ---
AZURE_CLIENT_ID=
# "common" pour autoriser à la fois comptes perso et pro/scolaire
AZURE_TENANT_ID=common
AZURE_SCOPES=Notes.Read

# --- OneNote ---
ONENOTE_NOTEBOOK_NAME=Computer Science

# --- Ollama (génération + éventuellement embeddings) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERATION_MODEL=
OLLAMA_EMBEDDING_MODEL=

# --- Modèles Hugging Face (si sentence-transformers plutôt qu'Ollama) ---
EMBEDDING_MODEL_HF=Qwen/Qwen3-Embedding-0.6B
RERANKER_MODEL_HF=BAAI/bge-reranker-v2-m3

# --- Chemins locaux ---
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_INDEX_DIR=./data/index
